# PM Partner Portal routing — add these rules to your existing /_redirects file
# (Cloudflare Pages applies rules in order; add these BEFORE any catch-all rules)

/partner/                  /partner/index.html  200
/partner/*                 /partner/index.html  200
# Cloudflare Pages _redirects
# Pretty-URL routing for building-scoped pages. The 200 status keeps the
# original URL in the address bar while serving the static HTML — pages
# themselves extract the slug from window.location.pathname.
/                          /buildings/        302
# HOA pitch deck — board-facing
/building/*/hoa-pitch/     /hoa-pitch.html    200
/building/*/hoa-pitch      /hoa-pitch.html    200
# Homeowner petition — owner-facing
/building/*/petition/      /petition.html     200
/building/*/petition       /petition.html     200
# Public partner portfolio pages — firm-facing
/partners/*/               /partners/index.html  200
/partners/*                /partners/index.html  200
